# Normaliza los finales de línea: LF en el repositorio, lo que use cada
# sistema en la copia de trabajo. Evita el aviso de "LF will be replaced
# by CRLF" en cada commit.
* text=auto

# Binarios: que git no intente convertirlos ni diffearlos nunca.
*.jpg   binary
*.jpeg  binary
*.jfif  binary
*.png   binary
*.webp  binary
*.mp4   binary
*.webm  binary
*.ico   binary
*.woff  binary
*.woff2 binary
